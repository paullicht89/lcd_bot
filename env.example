# LCD Teams Bot environment template

# Bot Framework identity.
# For this internal company bot, use SingleTenant unless Microsoft/admin policy says otherwise.
MicrosoftAppType=SingleTenant
MicrosoftAppId=
MicrosoftAppPassword=
MicrosoftAppTenantId=

# Server.
BOT_HOST=127.0.0.1
BOT_PORT=3978
BOT_PUBLIC_BASE_URL=https://lcdbot.lcd.nyc
LOG_LEVEL=INFO

# Optional Microsoft Graph integration for future commands.
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=
GRAPH_SCOPE=https://graph.microsoft.com/.default

# Optional external APIs for future commands.
CONNECTEAM_API_KEY=
NYS_APP_TOKEN=
MAPTIVE_SYNC_SECRET=
DATAVERSE_SYNC_SECRET=

# Fieldboss user lookup (/fbusers). Application credentials obtain fresh tokens.
DATAVERSE_URL=https://lcdelevator.crm.dynamics.com
DATAVERSE_TENANT_ID=
DATAVERSE_CLIENT_ID=
DATAVERSE_CLIENT_SECRET=
# Optional temporary bearer token; takes precedence over application credentials.
DATAVERSE_ACCESS_TOKEN=

# Splashtop device lookup (/splashtoppc).
SPLASHTOP_API_TOKEN=
SPLASHTOP_TEAM_ID=

# Local development.
ENVIRONMENT=local
